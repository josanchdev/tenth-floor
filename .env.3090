# =============================================================================
# Hardware profile: RTX 3090 (24 GB VRAM)
# Model: Qwen3-32B-AWQ (4-bit quantized)
# Context: 10240 tokens (KV cache limit at 90% utilization)
# =============================================================================
# Usage: cp .env.3090 .env  — then fill in your secrets below

# ─── vLLM ────────────────────────────────────────────────────────────────────
VLLM_MODEL=Qwen/Qwen3-32B-AWQ
VLLM_MAX_MODEL_LEN=10240
VLLM_GPU_UTIL=0.90
VLLM_MAX_NUM_SEQS=32

# ─── Langfuse ────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Discord ─────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ─── Optional ────────────────────────────────────────────────────────────────
# HUGGING_FACE_HUB_TOKEN=hf_...   # only needed for gated/private models
