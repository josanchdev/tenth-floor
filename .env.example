# =============================================================================
# The Tenth Floor AI – Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env is git-ignored. Never commit real keys.

# -----------------------------------------------------------------------------
# Local LLM  (vLLM / Ollama / any OpenAI-compatible server)
# -----------------------------------------------------------------------------
# Override the base URL from config/models.yaml (optional — defaults to
# http://localhost:8000/v1 which is the vLLM default).
# LLM_BASE_URL=http://localhost:8000/v1

# Only needed if your inference server requires an API key (e.g. OpenAI,
# hosted vLLM with auth).  Local vLLM does not need this.
# OPENAI_API_KEY=not-needed

# -----------------------------------------------------------------------------
# Langfuse  (https://cloud.langfuse.com → sign up → create project → API keys)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Optional: override if self-hosting Langfuse
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# Discord Webhooks  (Server Settings → Integrations → Webhooks → Copy URL)
# -----------------------------------------------------------------------------
# DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/...

# -----------------------------------------------------------------------------
# Notion Signal Journal  (auto-posts signals + resolves outcomes)
# -----------------------------------------------------------------------------
# 1. notion.so/my-integrations → New integration → copy token below
# 2. Open Signal Journal database in Notion → ··· → Connections → add integration
# 3. Copy the database ID from the URL: notion.so/workspace/<DATABASE_ID>?v=...
NOTION_INTEGRATION_TOKEN=secret_...
NOTION_SIGNAL_DATABASE_ID=33d3c561b1d480c8a85bdde20f0a397c

# -----------------------------------------------------------------------------
# Optional overrides  (defaults match config/services.yaml)
# -----------------------------------------------------------------------------
CACHE_DIR=data/raw

# -----------------------------------------------------------------------------
# Project root  (only needed for wheel installs: pip install . without -e)
# -----------------------------------------------------------------------------
# Wheel installations place the package in site-packages, where the automatic
# file-walk resolution cannot locate the project root.  Set this to the
# absolute path of your project checkout in that case.
# TENTH_FLOOR_ROOT=/absolute/path/to/the-tenth-floor
