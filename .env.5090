# =============================================================================
# Hardware profile: RTX 5090 (32 GB VRAM)
# Model: Qwen3-32B-AWQ — upgrade to Qwen3.5 or larger when available
# Context: 32768 tokens (full long-context window)
# =============================================================================
# Usage: cp .env.5090 .env  — then fill in your secrets below

# ─── vLLM ────────────────────────────────────────────────────────────────────
VLLM_MODEL=Qwen/Qwen3-32B-AWQ
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_UTIL=0.92
VLLM_MAX_NUM_SEQS=64

# ─── Langfuse ────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Discord ─────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ─── Optional ────────────────────────────────────────────────────────────────
# HUGGING_FACE_HUB_TOKEN=hf_...   # only needed for gated/private models
